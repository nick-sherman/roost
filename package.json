{
  "name": "roost",
  "productName": "Roost",
  "version": "1.0.1",
  "description": "Keeps your project commands running, one window, one folder each.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "npm run icons && node scripts/stage-pty.mjs && electron-forge package",
    "make": "npm run icons && node scripts/stage-pty.mjs && electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "icons": "node scripts/make-icons.mjs && node scripts/make-appicon.mjs",
    "typecheck": "tsc --noEmit",
    "test:config": "esbuild test/config-roundtrip.ts --bundle --platform=node --format=cjs --external:electron --outfile=test/bundle.cjs && electron test/bundle.cjs",
    "test:cwd": "esbuild test/cwd-check.ts --bundle --platform=node --format=cjs --external:electron --external:node-pty --outfile=test/cwd-bundle.cjs && electron test/cwd-bundle.cjs",
    "test": "npm run test:config && npm run test:cwd && npm run test:lifecycle",
    "test:path": "esbuild test/path-check.ts --bundle --platform=node --format=cjs --external:electron --external:node-pty --outfile=test/path-bundle.cjs && electron test/path-bundle.cjs",
    "test:lifecycle": "esbuild test/lifecycle-check.ts --bundle --platform=node --format=cjs --external:electron --external:node-pty --outfile=test/lifecycle-bundle.cjs && electron test/lifecycle-bundle.cjs"
  },
  "keywords": [
    "electron",
    "macos",
    "process-manager",
    "terminal",
    "developer-tools"
  ],
  "author": {
    "name": "Nick Sherman",
    "email": "15221415+nick-sherman@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nick-sherman/roost.git"
  }
}
